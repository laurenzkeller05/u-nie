# Kopieren nach .env und selbst ausfüllen. .env ist gitignored.
# Gleiche Zugangsdaten für Sakai und myMCI.
MCI_USER=xx1234@mci4me.at
MCI_PASS=

# Optional statt Passwort: Sakai-Session-Cookie aus dem Browser (Wert von JSESSIONID)
# SAKAI_COOKIE=

# Uni-Wurzel: Kurse landen in <n>_Semester/Sakai/<Kurs>/
MCI_UNI_DIR=~/Me/Uni
